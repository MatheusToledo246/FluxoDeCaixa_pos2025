<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Tipo:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/spTipo"
        android:layout_width="282dp"
        android:layout_height="28dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toEndOf="@+id/textView"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDetalhe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Detalhe:"
        app:layout_constraintStart_toStartOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <!-- Data de Lançamento -->

    <Spinner
        android:id="@+id/spDetalhe"
        android:layout_width="282dp"
        android:layout_height="27dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="@+id/spTipo"
        app:layout_constraintTop_toBottomOf="@+id/spTipo" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Valor:"
        app:layout_constraintStart_toStartOf="@+id/tvDetalhe"
        app:layout_constraintTop_toBottomOf="@+id/tvDetalhe" />

    <EditText
        android:id="@+id/etValor"
        android:layout_width="686dp"
        android:layout_height="47dp"
        android:layout_marginTop="8dp"
        android:inputType="numberDecimal"
        app:layout_constraintStart_toStartOf="@+id/spDetalhe"
        app:layout_constraintTop_toBottomOf="@+id/spDetalhe" />


    <!-- Botões -->

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Data de Lançamento:"
        app:layout_constraintStart_toStartOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/etValor" />

    <Button
        android:id="@+id/btSelecionarData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:layout_marginTop="24dp"
        android:text="Selecionar Data"
        app:layout_constraintStart_toEndOf="@+id/textView3"
        app:layout_constraintTop_toBottomOf="@+id/etValor" />

    <TextView
        android:id="@+id/tvDataSelecionada"
        android:layout_width="145dp"
        android:layout_height="24dp"
        android:layout_marginStart="32dp"
        android:paddingTop="8dp"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintStart_toStartOf="@+id/btSelecionarData"
        app:layout_constraintTop_toBottomOf="@+id/btSelecionarData" />

    <Button
        android:id="@+id/btLancar"
        android:layout_width="345dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="Lançar"
        app:layout_constraintStart_toStartOf="@+id/textView3"
        app:layout_constraintTop_toBottomOf="@+id/tvDataSelecionada" />

    <Button
        android:id="@+id/btVerLancamento"
        android:layout_width="345dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="Ver Lançamentos"
        app:layout_constraintEnd_toEndOf="@+id/btLancar"
        app:layout_constraintStart_toStartOf="@+id/btLancar"
        app:layout_constraintTop_toBottomOf="@+id/btLancar" />

    <Button
        android:id="@+id/btSaldo"
        android:layout_width="345dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="Saldo"
        app:layout_constraintStart_toStartOf="@+id/btVerLancamento"
        app:layout_constraintTop_toBottomOf="@+id/btVerLancamento" />


</androidx.constraintlayout.widget.ConstraintLayout>